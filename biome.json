{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "packages/*/src/**",
      "packages/*/test/**"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "useIterableCallbackReturn": "off",
        "noAssignInExpressions": "off",
        "noShadowRestrictedNames": "off",
        "noRedundantUseStrict": "off"
      },
      "complexity": {
        "noCommaOperator": "off",
        "useOptionalChain": "off",
        "useMathMinMax": "off"
      },
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/panel/src/**",
        "apps/site/site.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "error"
          }
        }
      }
    }
  ]
}

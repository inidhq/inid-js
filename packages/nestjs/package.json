{
  "name": "@inid/nestjs",
  "version": "0.1.0",
  "description": "Sign-in with InID for NestJS (Express or Fastify): a module with the sign-in routes and a fresh session, a guard with @Public, @Roles and @Permissions, @CurrentUser, bearer tokens from native apps, and webhooks.",
  "license": "MIT",
  "homepage": "https://inid.co/docs/frameworks/",
  "keywords": ["inid", "auth", "authentication", "sign-in", "oidc", "passkeys", "nestjs", "nest", "guard"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "rm -rf dist && pnpm build:esm && pnpm build:cjs && ../../node_modules/.bin/tsc -p tsconfig.build.json",
    "build:esm": "../../node_modules/.bin/esbuild src/index.ts --bundle --format=esm --platform=node --target=node18 --tsconfig-raw='{\"compilerOptions\":{\"experimentalDecorators\":true}}' --external:@nestjs/* --external:@inid/* --external:rxjs --external:reflect-metadata --outfile=dist/index.js",
    "build:cjs": "../../node_modules/.bin/esbuild src/index.ts --bundle --format=cjs --platform=node --target=node18 --tsconfig-raw='{\"compilerOptions\":{\"experimentalDecorators\":true}}' --external:@nestjs/* --external:rxjs --external:reflect-metadata --outfile=dist/index.cjs",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": { "@inid/node": "workspace:^", "@inid/server": "workspace:^" },
  "peerDependencies": { "@nestjs/common": ">=10", "@nestjs/core": ">=10", "reflect-metadata": ">=0.1.12", "rxjs": ">=7" },
  "devDependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/testing": "^11.1.0",
    "@types/supertest": "^6.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.0.0"
  },
  "publishConfig": { "access": "public" }
}
